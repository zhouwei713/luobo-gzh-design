NODE_ENV=production
# 本地免登录调测请用 npm run dev:local，生产启动不启用。
LOCAL_DISCOVERY_DEBUG=0
# 二期仅供本地开发显式启用，production环境始终关闭。
ENABLE_PHASE2=0
HOST=127.0.0.1
# 部署示例使用3100，避免与服务器已有3000端口的项目冲突。
PORT=3100
# 必须设为用户实际访问的域名，不能带路径。会用于生成图片 URL。
PUBLIC_URL=https://editor.example.com
DATA_DIR=./data
STATIC_DIR=../app/dist
# 仅在Node只监听本机、前面是自己管理的Nginx且覆盖X-Real-IP时设为1。
TRUST_PROXY_LOOPBACK=0
# 可选：32字节随机密钥的base64。留空时自动使用DATA_DIR/.credentials-key。
# 请持久保管，已有密文后不可随意更换。不要把实际密钥提交到Git。
CREDENTIALS_ENCRYPTION_KEY=
# 主服务以gzh用户运行；安装并验证Chrome/Chromium后填实际路径，留空时采用SVG回退。
CHROMIUM_EXECUTABLE_PATH=
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
AI_FORMAT_LOG_LEVEL=basic
AI_MAX_INPUT_CHARS=30000
AI_DAILY_QUOTA_FREE=20
AI_DAILY_QUOTA_VIP=200
# RedFox 爆文文章库：仅后端读取，默认不自动采集。
REDFOX_API_KEY=
REDFOX_KEYWORD_COLLECTION=0
# 区间采集最多一次；逐日补采受单批上限限制。每日预算默认20，0为停用。
REDFOX_DAILY_REQUEST_LIMIT=20
REDFOX_SYNC_COOLDOWN_SECONDS=60
# 逐日补采单批最多请求数，默认7，上限31。不会自动创建任务。
REDFOX_MAX_BATCH_REQUESTS=7
# 同一批相邻请求的间隔毫秒，默认1000。
REDFOX_BATCH_INTERVAL_MS=1000
# 每用户每日AI原创简报次数；0为关闭，手工编辑仍可用。
